# PostgreSQL (Supabase)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
DB_SSL=true
DB_SYNC=false

# Supabase Storage (Project Settings → API)
# Sin estas vars, los uploads van a disco local `uploads/`
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=rise-uploads

PORT=3000
JWT_SECRET=change_me

# Correo (Gmail + contraseña de aplicación)
# Cuenta destino de notificaciones web: serviciosmedicosrise@gmail.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=serviciosmedicosrise@gmail.com
MAIL_PASS=
# Pegar la contraseña de aplicación SIN espacios (16 caracteres)
# Si Google muestra "abcd efgh ijkl mnop", guarda: abcdefghijklmnop
MAIL_TO=serviciosmedicosrise@gmail.com
