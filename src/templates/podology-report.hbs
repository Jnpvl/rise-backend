<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Seguimiento Podológico</title>
  <style>
    @page {
      size: A4 portrait;
      margin: 8mm;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      padding: 0;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 9.5pt;
      color: #15202b;
      line-height: 1.3;
    }

    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 2px solid #E540AE;
      padding-bottom: 6px;
      margin-bottom: 8px;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .logo {
      height: 44px;
      width: auto;
    }

    .clinic-name {
      font-size: 14pt;
      font-weight: 700;
      color: #E540AE;
      text-transform: uppercase;
      margin: 0;
    }

    .clinic-subtitle {
      font-size: 9pt;
      color: #B0307E;
      margin: 2px 0 0;
    }

    .doc-title {
      text-align: right;
    }

    .doc-title h1 {
      margin: 0;
      font-size: 12pt;
      color: #15202b;
    }

    .doc-title p {
      margin: 2px 0 0;
      font-size: 8.5pt;
      color: #5b6b7c;
    }

    .meta {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4px 16px;
      margin-bottom: 8px;
      padding: 7px 10px;
      border: 1px solid #e2ebf0;
      border-radius: 8px;
      background: #f8fbfc;
    }

    .meta .label {
      font-size: 7.5pt;
      font-weight: 700;
      text-transform: uppercase;
      color: #5b6b7c;
    }

    .meta .value {
      font-size: 9.5pt;
      font-weight: 600;
    }

    .section {
      margin-bottom: 7px;
    }

    .section-title {
      font-size: 9.5pt;
      font-weight: 700;
      color: #E540AE;
      text-transform: uppercase;
      border-left: 3px solid #20D0DF;
      padding-left: 8px;
      margin: 0 0 4px;
    }

    .box {
      border: 1px solid #e2ebf0;
      border-radius: 6px;
      padding: 6px 8px;
      min-height: 22px;
      white-space: pre-wrap;
      font-size: 9.5pt;
    }

    table.conditions {
      width: 100%;
      border-collapse: collapse;
      font-size: 9.5pt;
    }

    table.conditions th,
    table.conditions td {
      border: 1px solid #d7e2e8;
      padding: 3px 6px;
      text-align: left;
    }

    table.conditions th {
      background: #fce7f5;
      color: #B0307E;
      font-size: 8.5pt;
      text-transform: uppercase;
    }

    table.conditions .mark {
      text-align: center;
      width: 38px;
      font-weight: 700;
      color: #14b8c7;
      font-size: 10pt;
    }

    .two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px 10px;
    }

    .diagrams {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px 12px;
      margin-bottom: 0;
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .diagrams:has(.diagram-block:only-child) {
      grid-template-columns: 1fr;
    }

    .diagram-block {
      margin: 0;
    }

    .diagram,
    .signature img {
      max-width: 100%;
      height: auto;
      border: 1px solid #e2ebf0;
      border-radius: 6px;
      background: #fff;
    }

    .diagram {
      max-height: 210px;
      width: 100%;
      object-fit: contain;
      display: block;
      margin: 0 auto;
    }

    .page-two {
      page-break-before: always;
      break-before: page;
    }

    .signature {
      text-align: center;
    }

    .signature img {
      max-height: 78px;
      display: block;
      margin: 0 auto 4px;
    }

    .signature .caption {
      font-size: 8pt;
      color: #5b6b7c;
      border-top: 1px solid #E540AE;
      padding-top: 4px;
      margin-top: 4px;
    }

    .consent {
      font-size: 8.5pt;
      color: #5b6b7c;
      font-style: italic;
      border: 1px dashed #e2ebf0;
      border-radius: 6px;
      padding: 6px 8px;
    }

    .closing {
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .footer {
      margin-top: 8px;
      padding-top: 6px;
      border-top: 1px solid #e2ebf0;
      display: flex;
      justify-content: space-between;
      font-size: 8pt;
      color: #5b6b7c;
    }

    .muted {
      color: #5b6b7c;
      font-style: italic;
    }
  </style>
</head>
<body>
  <div class="header">
    <div class="header-left">
      {{#if logoPath}}
      <img class="logo" src="{{logoPath}}" alt="RISE" />
      {{/if}}
      <div>
        <p class="clinic-name">RISE</p>
        <p class="clinic-subtitle">Servicios Médicos</p>
      </div>
    </div>
    <div class="doc-title">
      <h1>Seguimiento podológico</h1>
    </div>
  </div>

  <div class="meta">
    <div>
      <div class="label">Paciente</div>
      <div class="value">{{patientName}}</div>
    </div>
    <div>
      <div class="label">Fecha de seguimiento</div>
      <div class="value">{{followUpDate}}</div>
    </div>
    <div>
      <div class="label">Podólogo / profesional</div>
      <div class="value">{{staffName}}</div>
    </div>
    <div>
      <div class="label">Cédula</div>
      <div class="value">{{staffCedula}}</div>
    </div>
  </div>

  <div class="section">
    <h2 class="section-title">Observaciones iniciales</h2>
    <div class="box">{{#if initialObservations}}{{initialObservations}}{{else}}<span class="muted">Sin observaciones</span>{{/if}}</div>
  </div>

  <div class="section">
    <h2 class="section-title">Padecimientos</h2>
    {{#if conditions.length}}
    <table class="conditions">
      <thead>
        <tr>
          <th>Padecimiento</th>
          <th class="mark">Izq</th>
          <th class="mark">Der</th>
          <th>Padecimiento</th>
          <th class="mark">Izq</th>
          <th class="mark">Der</th>
        </tr>
      </thead>
      <tbody>
        {{#each conditionRows}}
        <tr>
          <td>{{leftLabel}}</td>
          <td class="mark">{{leftLeft}}</td>
          <td class="mark">{{leftRight}}</td>
          <td>{{rightLabel}}</td>
          <td class="mark">{{rightLeft}}</td>
          <td class="mark">{{rightRight}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <div class="box muted">Sin padecimientos marcados</div>
    {{/if}}
  </div>

  <div class="section two-col">
    <div>
      <h2 class="section-title">Tipo de pie derecho</h2>
      <div class="box">{{footTypeRight}}</div>
    </div>
    <div>
      <h2 class="section-title">Tipo de pie izquierdo</h2>
      <div class="box">{{footTypeLeft}}</div>
    </div>
  </div>

  {{#if dorsalDiagramDataUrl}}
  {{#if plantarDiagramDataUrl}}
  <div class="diagrams">
    <div class="diagram-block">
      <h2 class="section-title">Diagrama dorsal</h2>
      <img class="diagram" src="{{dorsalDiagramDataUrl}}" alt="Diagrama dorsal" />
    </div>
    <div class="diagram-block">
      <h2 class="section-title">Diagrama plantar</h2>
      <img class="diagram" src="{{plantarDiagramDataUrl}}" alt="Diagrama plantar" />
    </div>
  </div>
  {{else}}
  <div class="diagram-block">
    <h2 class="section-title">Diagrama dorsal</h2>
    <img class="diagram" src="{{dorsalDiagramDataUrl}}" alt="Diagrama dorsal" />
  </div>
  {{/if}}
  {{else}}
  {{#if plantarDiagramDataUrl}}
  <div class="diagram-block">
    <h2 class="section-title">Diagrama plantar</h2>
    <img class="diagram" src="{{plantarDiagramDataUrl}}" alt="Diagrama plantar" />
  </div>
  {{/if}}
  {{/if}}

  <div class="page-two">
  <div class="section">
    <h2 class="section-title">Exploración</h2>
    <div class="box">{{#if explorationNotes}}{{explorationNotes}}{{else}}<span class="muted">Sin notas</span>{{/if}}</div>
  </div>

  <div class="section">
    <h2 class="section-title">Referencia</h2>
    <div class="box">{{referralText}}</div>
  </div>

  <div class="section">
    <h2 class="section-title">Terapéutica</h2>
    <div class="box">{{#if therapeutics}}{{therapeutics}}{{else}}<span class="muted">Sin registro</span>{{/if}}</div>
  </div>

  <div class="section">
    <h2 class="section-title">Tratamiento</h2>
    <div class="box">{{#if treatment}}{{treatment}}{{else}}<span class="muted">Sin registro</span>{{/if}}</div>
  </div>

  <div class="closing">
    {{#if consentAccepted}}
    <div class="section">
      <h2 class="section-title">Consentimiento</h2>
      <div class="consent">{{consentText}}</div>
    </div>
    {{/if}}

    <div class="section two-col">
      <div class="signature">
        {{#if patientSignatureDataUrl}}
        <img src="{{patientSignatureDataUrl}}" alt="Firma del paciente" />
        {{else}}
        <div class="box muted" style="min-height:70px;">Sin firma</div>
        {{/if}}
        <div class="caption">Firma del paciente</div>
      </div>
      <div class="signature">
        {{#if podologistSignatureDataUrl}}
        <img src="{{podologistSignatureDataUrl}}" alt="Firma del podólogo" />
        {{else}}
        <div class="box muted" style="min-height:70px;">Sin firma</div>
        {{/if}}
        <div class="caption">Firma del podólogo</div>
      </div>
    </div>

    <div class="footer">
      <div>RISE · Servicios Médicos</div>
    </div>
  </div>
  </div>
</body>
</html>
